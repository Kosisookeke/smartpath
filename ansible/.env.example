# Ansible Environment Variables
# Copy this file to .env and fill in your actual values
# Then source it: source .env
# Or use: ./generate_inventory.sh

# ============================================
# REQUIRED VARIABLES
# ============================================

# VM Configuration
export APP_VM_PRIVATE_IP="10.0.2.4"              # Your VM's private IP address
export BASTION_PUBLIC_IP="20.x.x.x"              # Your bastion host's public IP

# ============================================
# OPTIONAL VARIABLES (with defaults)
# ============================================

# SSH Configuration
export ANSIBLE_USER="azureuser"                   # SSH user (default: azureuser)
export SSH_PRIVATE_KEY_FILE="~/.ssh/id_rsa"      # Path to SSH private key
export PYTHON_INTERPRETER="/usr/bin/python3"      # Python interpreter on remote host

# Application Configuration
export APP_DIRECTORY="/opt/smartpath"             # Application directory on VM

# ============================================
# DEPLOYMENT VARIABLES (for deploy.yml)
# ============================================

# Azure Container Registry
export ACR_LOGIN_SERVER="yourregistry.azurecr.io"
export ACR_USERNAME="your-acr-username"
export ACR_PASSWORD="your-acr-password"

# Database Configuration
export DB_HOST="your-db-host.postgres.database.azure.com"
export DB_NAME="smartpath"
export DB_USER="your-db-user"
export DB_PASSWORD="your-db-password"

# ============================================
# USAGE
# ============================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Edit .env with your actual values:
#    vim .env
#
# 3. Source the environment variables:
#    source .env
#
# 4. Generate inventory:
#    ./generate_inventory.sh
#
# 5. Test connection:
#    ansible app_server -i inventory.ini -m ping
#
# 6. Run playbooks:
#    ansible-playbook -i inventory.ini setup.yml
#    ansible-playbook -i inventory.ini deploy.yml
#
# ============================================
# SECURITY NOTES
# ============================================
#
# - Never commit .env file to version control
# - .env is already in .gitignore
# - Use SSH keys instead of passwords
# - Store production secrets in GitHub Secrets
# - Use Azure Key Vault for production credentials
